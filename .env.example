# Copy to .env and fill in for local dev. Nothing here is a real secret.

# --- Postgres ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@postgres:5432/jobpilot

# --- MongoDB ---
MONGO_URL=mongodb://mongo:27017
MONGO_DB=jobpilot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ / Celery ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- LLM provider (managed key mode; BYOK comes later in Phase 10) ---
# Gemini Flash — free tier. Get LLM_API_KEY from Google AI Studio
# (aistudio.google.com) — this is NOT the same credential as the Google
# OAuth client id/secret below (that one's for login, this one's for LLM
# calls; different consoles, different keys).
LLM_PROVIDER=google
LLM_API_KEY=changeme
LLM_MODEL=gemini-2.5-flash

# --- Rate limiting (Phase 1: token bucket sized to your real provider quota) ---
LLM_RATE_LIMIT_RPM=60

# --- Auth: Google (primary login option, alongside email+password) ---
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Auth: GitHub (optional — connected later from the profile screen for
# Phase 3 RAG ingestion; not a login path) ---
GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

FRONTEND_URL=http://localhost:3000

# Session JWT we issue after register/login/Google sign-in succeeds —
# generate a real one with `openssl rand -hex 32` before this ever runs
# anywhere but your laptop.
JWT_SECRET=changeme

# --- Service ports ---
AGENT_CORE_PORT=8000
NOTIFY_PORT=4000
